# ==========================================
# Root .gitignore for SaaS Platform Monorepo
# ==========================================

# Compiled Backend Artifacts (Java / Maven)
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Node / Next.js / Frontend
node_modules/
**/node_modules/
.next/
**/.next/
out/
dist/
build/
.npm
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# IDE / Editor Configurations
.idea/
*.iml
.vscode/
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# OS-specific Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs & Temporary Files
logs/
*.log
*.tmp
*.temp
temp/
tmp/
